[Unit]
Description=BraveOS graphical session (X + Openbox)
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service network.target
Wants=network.target

# Root runs X (the console/DRM handshake needs it on a bare live boot);
# the user session itself is dropped to 'brave' via runuser inside the script.
[Service]
Type=simple
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=yes
ExecStartPre=+/bin/sh -c 'echo bravos-session-starting > /dev/kmsg'
ExecStart=/usr/local/bin/bravos-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
