#!/bin/bash
# BraveOS Openbox autostart (runs as user 'brave' inside the session).

echo "bravos-autostart: compositing + panel + tray" >> "$XDG_RUNTIME_DIR/bravos.log" 2>/dev/null

# Allow root (pkexec-launched installer) to draw on the user's screen
xhost +si:localuser:root >/dev/null 2>&1

# Compositor: shadows + fade animations
picom --config /usr/share/bravos/picom/picom.conf -b >/dev/null 2>&1 &

# Panel: launchers, taskbar, systray, clock
tint2 -c /usr/share/bravos/tint2/tint2rc >/dev/null 2>&1 &

# Network tray applet
nm-applet >/dev/null 2>&1 &

# Desktop: wallpaper + icons (via the file manager)
pcmanfm --desktop --profile bravos >/dev/null 2>&1 &

sleep 1.5

MODE="run"
grep -q 'bravos.installer=1' /proc/cmdline 2>/dev/null && MODE="installer"

case "$MODE" in
  installer)
    echo "bravos-autostart: installer mode" >> "$XDG_RUNTIME_DIR/bravos.log" 2>/dev/null
    pkexec /usr/local/bin/bravos-installer >/dev/null 2>&1 &
    ;;
  *)
    if [ -d /run/live ]; then
      echo "bravos-autostart: live welcome" >> "$XDG_RUNTIME_DIR/bravos.log" 2>/dev/null
      /usr/local/bin/bravos-welcome >/dev/null 2>&1 &
    else
      echo "bravos-autostart: launching brave (installed system)" >> "$XDG_RUNTIME_DIR/bravos.log" 2>/dev/null
      brave --maximized --no-first-run >/dev/null 2>&1 &
    fi
    ;;
esac
