#!/usr/bin/env python3
"""bravos-lock — BraveOS screen locker.

A fullscreen dark-glass overlay with clock, brave lion emblem and a
password entry. Authentication happens through /sbin/unix_chkpwd (the
distro's setuid PAM password checker for unprivileged clients), so no
root is needed and the real account password is required.

Fails CLOSED: any internal error keeps the screen locked.
Ctrl+Alt+F2 still gives a real terminal (deliberately, to avoid lockouts
on broken graphics) — real lockout hardening is out of scope for v1.
"""
import math
import os
import pwd
import subprocess
import sys
import time

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

I18N_DIR = "/usr/share/bravos/i18n"
TRANS = {}


def detect_lang():
    lang = os.environ.get("BRAVEOS_LANG") or os.environ.get("LANG") or "en"
    lang = lang.split(".")[0].lower()
    for cand in (lang, lang.replace("-", "_"), lang.split("_")[0],
                 lang.split("-")[0]):
        path = os.path.join(I18N_DIR, "lock", cand + ".conf")
        if os.path.exists(path):
            with open(path, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        TRANS[k.strip()] = v.strip().strip('"').strip("'")
            return cand
    return "en"


def tr(key, fallback):
    return TRANS.get(key, fallback)


def check_password(user, password):
    """Validate with unix_chkpwd (Debian's setuid helper for exactly this).
    Returns True/False; False on ANY error (fail closed)."""
    helper = "/sbin/unix_chkpwd"
    if not os.path.exists(helper):
        return False
    try:
        p = subprocess.run([helper, user, "bravos-lock"],
                           input=password + "\x00",
                           capture_output=True, timeout=10)
        return p.returncode == 0
    except Exception:
        return False


class LockScreen(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_name("bravoslock")
        self.fullscreen()
        self.grab_add()

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)

        self.user = os.environ.get("USER") or pwd.getpwuid(
            os.getuid()).pw_name

        # big clock label
        self.clock = Gtk.Label()
        self.clock.get_style_context().add_class("clock")
        self.date = Gtk.Label()
        self.date.get_style_context().add_class("date")

        # password entry
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text(
            tr("lock_password", "Password"))
        self.entry.set_visibility(False)
        self.entry.set_can_default(True)
        self.entry.set_width_chars(24)
        self.entry.set_name("lockentry")
        self.entry.connect("activate", self.on_activate)
        self.entry.connect("changed", self.on_changed)

        self.status = Gtk.Label()
        self.status.set_name("lockstatus")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.pack_start(self.clock, False, False, 0)
        box.pack_start(self.date, False, False, 0)
        box.pack_start(self.entry, False, False, 0)
        box.pack_start(self.status, False, False, 0)

        align = Gtk.Alignment.new(0.5, 0.5, 0, 0)
        align.add(box)

        self.da = Gtk.DrawingArea()
        self.da.set_name("lockbg")
        self.da.connect("draw", self.on_draw)

        # layered stack: painted background + centered content
        fixed = Gtk.Fixed()
        fixed.put(self.da, 0, 0)
        fixed.put(align, 0, 0)
        self.fixed = fixed
        self.align = align
        self.add(fixed)
        self.da.show_all()
        align.show_all()

        self.connect("configure-event", self.on_configure)
        self.attempts = 0

    def on_configure(self, *a):
        w = self.get_allocated_width()
        h = self.get_allocated_height()
        self.fixed.move(self.align, 0, 0)
        self.align.set_size_request(w, h)
        self.da.set_size_request(w, h)
        return False

    def on_draw(self, da, cr):
        w = da.get_allocated_width()
        h = da.get_allocated_height()
        # deep cosmic gradient
        grad = cairo.LinearGradient(0, 0, w * 0.4, h)
        grad.add_color_stop_rgb(0.0, 0.05, 0.02, 0.16)
        grad.add_color_stop_rgb(0.55, 0.10, 0.05, 0.24)
        grad.add_color_stop_rgb(1.0, 0.16, 0.07, 0.28)
        cr.set_source(grad)
        cr.paint()
        # faint lion watermark
        cx, cy = w / 2, h / 2
        cr.save()
        cr.set_source_rgba(1, 1, 1, 0.05)
        draw_lion(cr, cx, cy, min(w, h) * 0.30)
        cr.restore()
        # vignette bars
        cr.set_source_rgba(0, 0, 0, 0.35)
        cr.rectangle(0, 0, w, h * 0.08)
        cr.rectangle(0, h * 0.92, w, h * 0.08)
        cr.fill()
        return True

    def on_changed(self, e):
        self.status.set_text("")

    def on_activate(self, e):
        pw = e.get_text()
        e.set_text("")
        if not pw:
            return
        if check_password(self.user, pw):
            self.grab_remove()
            Gtk.main_quit()
        else:
            self.attempts += 1
            self.status.set_text(tr("lock_wrong", "Wrong password"))
            # brief hardening delay
            time.sleep(min(2.0, 0.2 * self.attempts))

    def tick_clock(self):
        t = time.localtime()
        self.clock.set_text(time.strftime("%H:%M", t))
        d = time.strftime("%A, %B %d", t)
        if getattr(self, "_last_date", None) != d:
            self._last_date = d
            self.date.set_text(d)
        return True


def draw_lion(cr, cx, cy, s):
    grad = cairo.LinearGradient(cx - s, cy - s, cx + s, cy + s)
    grad.add_color_stop_rgb(0.0, 0.984, 0.329, 0.169)
    grad.add_color_stop_rgb(0.5, 0.941, 0.306, 0.137)
    grad.add_color_stop_rgb(1.0, 0.812, 0.208, 0.086)
    cr.set_source(grad)
    w, hh = s * 0.92, s * 1.0
    x0, y0 = cx - w / 2, cy - hh / 2
    cr.new_sub_path()
    cr.move_to(cx, y0 + hh * 0.06)
    cr.curve_to(x0 + w * 0.28, y0 - hh * 0.05, x0 + w * 0.72, y0 - hh * 0.05,
                x0 + w, y0 + hh * 0.14)
    cr.curve_to(x0 + w, y0 + hh * 0.62, cx + w * 0.18, y0 + hh * 0.9, cx,
                y0 + hh)
    cr.curve_to(cx - w * 0.18, y0 + hh * 0.9, x0, y0 + hh * 0.62, x0,
                y0 + hh * 0.14)
    cr.curve_to(x0, y0 + hh * 0.14, x0 + w * 0.06, y0 + hh * 0.02, cx,
                y0 + hh * 0.06)
    cr.close_path()
    cr.fill()
    cr.set_source_rgb(1, 1, 1)
    cr.set_line_width(s * 0.085)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    ey = cy - hh * 0.13
    cr.new_sub_path()
    cr.move_to(cx - w * 0.30, ey - s * 0.02)
    cr.line_to(cx - w * 0.11, ey + s * 0.045)
    cr.stroke()
    cr.new_sub_path()
    cr.move_to(cx + w * 0.30, ey - s * 0.02)
    cr.line_to(cx + w * 0.11, ey + s * 0.045)
    cr.stroke()
    cr.set_line_width(s * 0.07)
    my = cy + hh * 0.16
    cr.new_sub_path()
    cr.move_to(cx - w * 0.20, my)
    cr.curve_to(cx - w * 0.10, my + s * 0.08, cx - w * 0.03, my + s * 0.01,
                cx, my + s * 0.05)
    cr.curve_to(cx + w * 0.03, my + s * 0.01, cx + w * 0.10, my + s * 0.08,
                cx + w * 0.20, my)
    cr.stroke()


def main():
    detect_lang()
    css = b"""
    #bravoslock .clock { color: #ffffff; font-size: 64px; font-weight: 800;
                          text-shadow: 0 2px 18px rgba(0,0,0,.6); }
    #bravoslock .date { color: #c9c3e4; font-size: 18px; font-weight: 600; }
    #bravoslock #lockentry { border-radius: 12px; border: 1px solid
                             rgba(255,255,255,.16); padding: 10px 16px;
                             color: #ffffff; caret-color: #f04e23;
                             background: rgba(20,16,42,.72); font-size: 15px; }
    #bravoslock #lockentry:focus { border-color: #f04e23; }
    #bravoslock #lockstatus { color: #ff8a70; font-size: 13px; }
    """
    prov = Gtk.CssProvider()
    prov.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), prov,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = LockScreen()
    win.show_all()
    win.tick_clock()
    GLib.timeout_add(1000, win.tick_clock)
    win.entry.grab_focus()
    Gtk.main()


if __name__ == "__main__":
    main()
