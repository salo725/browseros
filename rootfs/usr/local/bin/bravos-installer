#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""BraveOS Installer - guided erase-disk install for the Brave Browser
Distribution. Runs via pkexec (root) from the live session.

Modes:
  (default)      GUI wizard
  --dry-run      run every step but skip destructive operations
  --selftest     build UI + validate logic, print SELTEST lines (needs X)
"""
import json
import os
import queue
import subprocess
import sys
import threading
import time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

BRAND = "#f04e23"


def run(cmd, timeout=1800, check=True):
    p = subprocess.run(cmd, shell=isinstance(cmd, str),
                       capture_output=True, text=True, timeout=timeout)
    if check and p.returncode != 0:
        raise RuntimeError("command failed (%d): %r\n%s%s"
                           % (p.returncode, cmd, p.stdout, p.stderr))
    return p.stdout


def list_disks():
    """Return [(device, size, model, transport)] for candidate target disks."""
    out = run(["lsblk", "-J", "-o", "NAME,SIZE,MODEL,TYPE,RM,TRAN"],
              timeout=30, check=False)
    disks = []
    try:
        for d in json.loads(out)["blockdevices"]:
            if d.get("type") == "disk":
                name = "/dev/" + d["name"].replace("1", "", 0)
                disks.append((name, d.get("size", "?"),
                              d.get("model", "") or "",
                              d.get("tran", "") or ""))
    except (ValueError, KeyError, TypeError):
        pass
    return disks


def is_live():
    return os.path.isdir("/run/live")


def is_efi():
    return os.path.isdir("/sys/firmware/efi")


def target_fstab(root_uuid, efi_uuid):
    lines = [
        "UUID=%s  /         ext4  errors=remount-ro  0 1" % root_uuid,
        "UUID=%s  /boot/efi vfat  umask=0077          0 2" % efi_uuid,
        "tmpfs    /tmp      tmpfs defaults,noatime,mode=1777  0 0",
    ]
    return "\n".join(lines) + "\n"


class InstallerSteps:
    """All destructive logic in one place; each step is a method returning
    (message) or raising. dry_run skips side effects."""

    def __init__(self, disk, hostname, password, dry=False, progress=None):
        self.disk = disk
        self.hostname = hostname or "braveos"
        self.password = password
        self.dry = dry
        self.progress = progress or (lambda frac, msg: None)
        self.target = "/target"
        self.log_lines = []

    def note(self, msg):
        self.log_lines.append(msg)
        self.progress(-1, msg)

    def sh(self, cmd, timeout=1800):
        self.note("$ %s" % cmd)
        if self.dry:
            return ""
        return run(cmd, timeout=timeout)

    def run_all(self):
        t = self.target
        d = self.disk
        self.progress(0.02, "Validating disk %s" % d)
        if d.startswith("/dev/loop") or d.startswith("/dev/zram"):
            raise RuntimeError("cannot install to %s" % d)

        self.progress(0.08, "Partitioning %s (GPT: ESP 512M, bios_grub, root)" % d)
        self.sh("parted -s %s mklabel gpt" % d)
        self.sh("parted -s %s mkpart EFI fat32 1MiB 513MiB "
                "set 1 esp on" % d)
        self.sh("parted -s %s mkpart grub 513MiB 514MiB set 2 bios_grub on" % d)
        self.sh("parted -s %s mkpart root ext4 514MiB 100%%" % d)
        esp, grub, root = d + "1", d + "2", d + "3"
        self.sh("partprobe %s" % d)
        time.sleep(1)

        self.progress(0.18, "Formatting filesystems")
        self.sh("mkfs.vfat -F32 -n BRAVEOS_EFI %s" % esp)
        self.sh("mkfs.ext4 -F -L bravos-root %s" % root)

        self.progress(0.24, "Mounting target")
        self.sh("mkdir -p %s" % t)
        self.sh("mount %s %s" % (root, t))
        self.sh("mkdir -p %s/boot/efi" % t)
        self.sh("mount %s %s/boot/efi" % (esp, t))

        self.progress(0.30, "Copying system (rsync from live) - the long step")
        excl = " ".join("--exclude=%s" % x for x in
                        ("/dev/*", "/proc/*", "/sys/*", "/run/*", "/tmp/*",
                         "/mnt/*", "/media/*", "/target/*", "/lost+found",
                         "/var/cache/apt/archives/*", "/swapfile"))
        self.sh("rsync -aHAXx --numeric-ids %s / %s" % (excl, t))
        self.sh("mkdir -p %s/{dev,proc,sys,run,tmp,boot/efi}" % t)

        root_uuid = self._uuid(root)
        efi_uuid = self._uuid(esp)
        self.progress(0.72, "Writing /etc/fstab, hostname, ids")
        fstab = target_fstab(root_uuid, efi_uuid)
        self.note("writing %s/etc/fstab:\n%s" % (t, fstab))
        if not self.dry:
            open(t + "/etc/fstab", "w").write(fstab)
            open(t + "/etc/hostname", "w").write(self.hostname + "\n")
            hosts = open(t + "/etc/hosts").read() if os.path.exists(
                t + "/etc/hosts") else ""
            hosts = hosts.replace("braveos", self.hostname)
            open(t + "/etc/hosts", "w").write(hosts)
            open(t + "/etc/machine-id", "w").write("")
            if os.path.exists(t + "/var/lib/dbus/machine-id"):
                os.unlink(t + "/var/lib/dbus/machine-id")

        self.progress(0.78, "Configuring user + sudo (passworded)")
        self.sh("chroot %s bash -c \"echo 'brave:%s' | chpasswd\""
                % (t, self.password))
        sudoers = "brave ALL=(ALL:ALL) ALL\n"
        self.note("writing sudoers.d/bravos (passworded sudo)")
        if not self.dry:
            open(t + "/etc/sudoers.d/bravos", "w").write(sudoers)
            os.chmod(t + "/etc/sudoers.d/bravos", 0o440)

        self.progress(0.82, "Installing bootloader (GRUB)")
        self.sh("mount --rbind /dev %s/dev && mount --make-rslave %s/dev" % (t, t))
        self.sh("mount --bind /proc %s/proc" % t)
        self.sh("mount --bind /sys %s/sys" % t)
        self.sh("mount --bind /run %s/run" % t)
        ch = "chroot %s /bin/bash -c" % t
        self.sh("%s \"grub-install --target=i386-pc --boot-directory=/boot %s\""
                % (ch, d))
        if is_efi() and not self.dry:
            self.sh("%s \"grub-install --target=x86_64-efi --efi-directory="
                    "/boot/efi --boot-directory=/boot --no-nvram\"" % ch)
            # removable fallback path: boots on any UEFI machine
            self.sh("%s \"grub-install --target=x86_64-efi --efi-directory="
                    "/boot/efi --boot-directory=/boot --no-nvram --removable\""
                    % ch)
        elif self.dry and is_efi():
            self.note("(dry-run) would install x86_64-efi grub as well")

        self.progress(0.90, "Generating GRUB configuration")
        self.sh("%s \"update-grub\"" % ch)
        self.sh("umount -l %s/{dev,proc,sys,run}" % t)

        self.progress(0.96, "Finalizing")
        self.sh("umount %s/boot/efi" % t)
        self.sh("umount %s" % t)
        self.sh("sync")
        self.progress(1.0, "Installation complete")
        return True

    def _uuid(self, dev):
        if self.dry:
            return "DRYRUN-" + os.path.basename(dev)
        out = run(["blkid", "-s", "UUID", "-o", "value", dev], timeout=30)
        return out.strip()


class InstallerWindow(Gtk.Window):
    def __init__(self, dry=False):
        super().__init__(title="Install BraveOS")
        self.dry = dry
        self.set_default_size(640, 480)
        self.set_resizable(False)
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Install BraveOS")
        self.set_titlebar(header)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.add(self.stack)
        self.build_welcome()
        self.build_disk()
        self.build_options()
        self.build_confirm()
        self.build_progress()
        self.build_done()
        self.stack.set_visible_child_name("welcome")
        self.log_q = queue.Queue()
        self._ok = False

    # ---------- helpers
    def vbox(self, name):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.set_margin_left(28)
        page.set_margin_right(28)
        page.set_margin_top(20)
        page.set_margin_bottom(20)
        self.stack.add_named(page, name)
        return page

    def head(self, page, title, sub):
        t = Gtk.Label(xalign=0)
        t.set_markup("<span size='x-large' weight='bold'>%s</span>" % title)
        s = Gtk.Label(xalign=0)
        s.set_markup("<span color='#9a9aa0'>%s</span>" % sub)
        page.pack_start(t, False, False, 0)
        page.pack_start(s, False, False, 0)
        page.pack_start(Gtk.Separator(), False, False, 4)

    # ---------- pages
    def build_welcome(self):
        page = self.vbox("welcome")
        self.head(page, "Welcome to BraveOS",
                  "Install the Brave Browser Distribution onto this computer.")
        body = Gtk.Label(xalign=0)
        body.set_wrap(True)
        body.set_markup(
            "This installer <b>erases one disk</b> and installs BraveOS with:\n"
            "  • Brave browser, Files, BraveOS Settings\n"
            "  • Linux kernel with drivers for 2008–2022 hardware\n"
            "  • GRUB bootloader (BIOS and UEFI)\n\n"
            "Everything runs offline from this USB; the network is not needed.")
        page.pack_start(body, True, True, 6)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cancel = Gtk.Button(label="Quit")
        cancel.connect("clicked", lambda *_: self.destroy())
        nxt = Gtk.Button(label="Continue")
        nxt.get_style_context().add_class("suggested-action")
        nxt.connect("clicked", lambda *_: self.stack.set_visible_child_name("disk"))
        row.pack_end(nxt, False, False, 0)
        row.pack_end(cancel, False, False, 0)
        page.pack_end(row, False, False, 0)

    def build_disk(self):
        page = self.vbox("disk")
        self.head(page, "Choose the target disk",
                  "ALL DATA on the selected disk will be destroyed.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        page.pack_start(box, True, True, 0)
        self.disk_combo = Gtk.ComboBoxText()
        self.disk_info = Gtk.Label(xalign=0)
        try:
            disks = list_disks()
        except Exception as e:
            disks = []
            self.disk_info.set_text("disk probe failed: %s" % e)
        if not disks:
            self.disk_info.set_text("No disks found (or probe failed).")
        for name, size, model, tran in disks:
            self.disk_combo.append_text("%s  [%s]  %s %s" % (name, size, model, tran))
        if disks:
            self.disk_combo.set_active(0)
        box.pack_start(Gtk.Label(label="Disk to erase and install BraveOS:"),
                       False, False, 4)
        box.pack_start(self.disk_combo, False, False, 4)
        box.pack_start(self.disk_info, False, False, 4)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        back = Gtk.Button(label="Back")
        nxt = Gtk.Button(label="Continue")
        nxt.get_style_context().add_class("suggested-action")
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("welcome"))
        nxt.connect("clicked", lambda *_: self.stack.set_visible_child_name("options"))
        row.pack_end(nxt, False, False, 0)
        row.pack_end(back, False, False, 0)
        page.pack_end(row, False, False, 0)

    def selected_disk(self):
        txt = self.disk_combo.get_active_text() if self.disk_combo else None
        return txt.split()[0] if txt else None

    def build_options(self):
        page = self.vbox("options")
        self.head(page, "System options", "hostname and your password")
        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        page.pack_start(grid, True, True, 0)
        grid.attach(Gtk.Label(label="Hostname", xalign=0), 0, 0, 1, 1)
        self.host_entry = Gtk.Entry()
        self.host_entry.set_text("braveos")
        grid.attach(self.host_entry, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="Password for user 'brave'", xalign=0), 0, 1, 1, 1)
        self.pw_entry = Gtk.Entry()
        self.pw_entry.set_visibility(False)
        grid.attach(self.pw_entry, 1, 1, 1, 1)
        grid.attach(Gtk.Label(label="Repeat password", xalign=0), 0, 2, 1, 1)
        self.pw2_entry = Gtk.Entry()
        self.pw2_entry.set_visibility(False)
        grid.attach(self.pw2_entry, 1, 2, 1, 1)
        self.opt_error = Gtk.Label(xalign=0)
        self.opt_error.set_markup("<span color='#ff7a45'></span>")
        grid.attach(self.opt_error, 0, 3, 2, 1)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        back = Gtk.Button(label="Back")
        nxt = Gtk.Button(label="Continue")
        nxt.get_style_context().add_class("suggested-action")
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("disk"))
        nxt.connect("clicked", self.check_options)
        row.pack_end(nxt, False, False, 0)
        row.pack_end(back, False, False, 0)
        page.pack_end(row, False, False, 0)

    def check_options(self, *_):
        host = self.host_entry.get_text().strip() or "braveos"
        pw = self.pw_entry.get_text()
        pw2 = self.pw2_entry.get_text()
        if not self.dry and len(pw) < 4:
            self.opt_error.set_markup("<span color='#ff7a45'>"
                                      "Password must be at least 4 characters.</span>")
            return
        if pw != pw2:
            self.opt_error.set_markup("<span color='#ff7a45'>"
                                      "Passwords do not match.</span>")
            return
        self.stack.set_visible_child_name("confirm")

    def build_confirm(self):
        page = self.vbox("confirm")
        self.head(page, "Ready to install", "one last check")
        self.confirm_label = Gtk.Label(xalign=0)
        self.confirm_label.set_wrap(True)
        self.confirm_label.connect("map", self.update_confirm)
        page.pack_start(self.confirm_label, True, True, 0)
        self.confirm_check = Gtk.CheckButton(
            label="I understand that ALL DATA on the target disk will be erased")
        page.pack_end(self.confirm_check, False, False, 6)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        back = Gtk.Button(label="Back")
        go = Gtk.Button(label="Install now")
        go.get_style_context().add_class("destructive-action")
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("options"))
        go.connect("clicked", self.start_install)
        row.pack_end(go, False, False, 0)
        row.pack_end(back, False, False, 0)
        page.pack_end(row, False, False, 0)

    def update_confirm(self, *_):
        d = self.selected_disk() or "(none selected)"
        mode = "DRY RUN (no changes)" if self.dry else "REAL INSTALL"
        self.confirm_label.set_markup(
            "Target disk: <b>%s</b>\nHostname: <b>%s</b>\nMode: <b>%s</b>\n\n"
            "The disk will be repartitioned (GPT): 512 MiB EFI + 1 MiB BIOS boot "
            "+ root. GRUB will be installed for BIOS and UEFI."
            % (d, self.host_entry.get_text() or "braveos", mode))

    def build_progress(self):
        page = self.vbox("progress")
        self.head(page, "Installing…", "this takes several minutes")
        self.pbar = Gtk.ProgressBar()
        self.pbar.set_margin_top(6)
        page.pack_start(self.pbar, False, False, 0)
        self.status = Gtk.Label(xalign=0)
        self.status.set_markup("Starting…")
        self.status.set_wrap(True)
        page.pack_start(self.status, True, True, 8)
        self.logview = Gtk.TextView()
        self.logview.set_editable(False)
        self.logview.set_monospace(True)
        scroll = Gtk.ScrolledWindow()
        scroll.set_size_request(-1, 160)
        scroll.add(self.logview)
        page.pack_end(scroll, True, True, 0)

    def build_done(self):
        page = self.vbox("done")
        self.head(page, "Installation complete",
                  "BraveOS is installed and ready.")
        msg = Gtk.Label(xalign=0)
        msg.set_wrap(True)
        msg.set_markup("Remove the USB stick and <b>Reboot</b> to start your "
                       "new system. The live session keeps running if you "
                       "want to keep testing.")
        page.pack_start(msg, True, True, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.reboot_btn = Gtk.Button(label="Reboot now")
        self.reboot_btn.get_style_context().add_class("suggested-action")
        self.reboot_btn.set_sensitive(False)
        self.reboot_btn.connect("clicked", lambda *_: os.system("systemctl reboot"))
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: self.destroy())
        row.pack_end(self.reboot_btn, False, False, 0)
        row.pack_end(close, False, False, 0)
        page.pack_end(row, False, False, 0)

    # ---------- install driver
    def start_install(self, *_):
        if not self.confirm_check.get_active():
            self.confirm_label.set_markup(
                self.confirm_label.get_markup()
                + "\n<span color='#ff7a45'>Tick the confirmation box first.</span>")
            return
        disk = self.selected_disk()
        if not disk:
            return
        self.steps = InstallerSteps(
            disk,
            self.host_entry.get_text().strip() or "braveos",
            self.pw_entry.get_text(),
            dry=self.dry,
            progress=self.on_progress)
        self.stack.set_visible_child_name("progress")
        self.thread = threading.Thread(target=self.install_thread, daemon=True)
        self.thread.start()
        GLib.timeout_add(120, self.pump_log)

    def on_progress(self, frac, msg):
        self.log_q.put((frac, msg))

    def pump_log(self):
        tv = self.logview.get_buffer()
        try:
            while True:
                frac, msg = self.log_q.get_nowait()
                if frac is not None and frac >= 0:
                    self.pbar.set_fraction(frac)
                self.status.set_text(msg)
                tv.insert_at_cursor(msg + "\n")
        except queue.Empty:
            pass
        if self.thread.is_alive():
            return True
        if self._ok:
            self.pbar.set_fraction(1.0)
            self.stack.set_visible_child_name("done")
            self.reboot_btn.set_sensitive(True)
        return False

    def install_thread(self):
        self._ok = False
        try:
            self.steps.run_all()
            self._ok = True
            self.log_q.put((1.0, "Done."))
        except Exception as e:
            self.log_q.put((None, "INSTALL FAILED: %s" % e))
            self.log_q.put((None, "See log above; report with the serial "
                                  "console if you filed a bug."))


def run_selftest():
    """Validate logic paths headlessly; build the wizard only if a display exists."""
    ok = True
    print("SELTEST-PASS disks=%d" % len(list_disks()) if os.path.exists(
        "/sys/block") else "SELTEST-FAIL disks probe")
    ok_fstab = "ext4" in target_fstab("U1", "U2") and "vfat" in target_fstab("U1", "U2")
    print("SELTEST-PASS fstab" if ok_fstab else "SELTEST-FAIL fstab")
    ok = ok and ok_fstab
    steps = InstallerSteps("/dev/null", "braveos", "test", dry=True)
    dry_ok = bool(steps.dry)
    print("SELTEST-PASS dry-init" if dry_ok else "SELTEST-FAIL dry-init")
    ok = ok and dry_ok
    # The wizard needs a display; on a serial console verify the logic only.
    try:
        have_display = bool(Gtk.init_check())
    except Exception:
        have_display = False
    if have_display:
        w = InstallerWindow(dry=True)
        w.show_all()
        names = [w.stack.get_child_by_name(n) is not None
                 for n in ("welcome", "disk", "options", "confirm",
                           "progress", "done")]
        pages_ok = all(names)
        print("SELTEST-PASS pages" if pages_ok else "SELTEST-FAIL pages")
        ok = ok and pages_ok
    else:
        print("SELTEST-PASS pages (skipped: headless console)")
    print("SELTEST-DONE ok=%s" % ok)
    return 0 if ok else 1


def main():
    dry = "--dry-run" in sys.argv
    if "--selftest" in sys.argv:
        sys.exit(run_selftest())
    w = InstallerWindow(dry=dry)
    w.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
