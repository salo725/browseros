#!/bin/bash
# BraveOS user-side session (runs as 'brave', started by bravos-session).
#
# v1.0.2 stack: picom (compositor) -> BraveWM (our custom C++ window
# manager, replaces Openbox) -> radial arc dock -> PCManFM desktop ->
# polkit agent -> Welcome/Brave. BraveWM exits 42 to request a restart
# (SIGUSR1 / "Restart BraveWM"); any other exit = clean logout.
set -u

export DISPLAY=:0
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=BRAVEOS
export DESKTOP_SESSION=bravos

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

LOG="$XDG_RUNTIME_DIR/bravos-session.log"
exec > "$LOG" 2>&1

if command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax --exit-with-session)" || true
  export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
fi

# Allow root (pkexec-launched installer) to draw on the user's screen
xhost +si:localuser:root >/dev/null 2>&1

echo "bravos-session-user: starting at $(date)"
touch "$XDG_RUNTIME_DIR/session-ready"

cleanup() {
    # WM is gone: bring the whole session down with it
    for p in bravos-dock pcmanfm lxpolkit picom; do
        pkill -x "$p" 2>/dev/null || true
    done
}
trap cleanup EXIT

# 1) compositor first, so the translucent bar/dock get real alpha
picom --config /usr/share/bravos/picom/picom.conf -b >/dev/null 2>&1 &
sleep 0.6

# 2) session apps: wait for BraveWM to own the screen, then start the
#    desktop (wallpaper + icons), polkit agent, dock and the first-run app
(
    for i in $(seq 1 40); do
        xprop -root _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1 && break
        sleep 0.25
    done
    sleep 0.5

    pcmanfm --desktop --profile bravos >/dev/null 2>&1 &
    lxpolkit >/dev/null 2>&1 &
    bravos-dock >/dev/null 2>&1 &

    MODE="run"
    grep -q 'bravos.installer=1' /proc/cmdline 2>/dev/null && MODE="installer"
    case "$MODE" in
      installer)
        echo "bravos-session-user: installer mode"
        pkexec /usr/local/bin/bravos-installer >/dev/null 2>&1 &
        ;;
      *)
        if [ -d /run/live ]; then
            echo "bravos-session-user: live welcome"
            /usr/local/bin/bravos-welcome >/dev/null 2>&1 &
        else
            echo "bravos-session-user: installed system: launching brave"
            brave --maximized --no-first-run >/dev/null 2>&1 &
        fi
        ;;
    esac
) &

# 3) BraveWM in the foreground (restart loop; exit 42 = restart)
while true; do
    bravos-wm
    rc=$?
    echo "bravos-session-user: bravos-wm exited rc=$rc"
    if [ "$rc" -ne 42 ]; then
        break
    fi
    sleep 0.4
done
exit 0
