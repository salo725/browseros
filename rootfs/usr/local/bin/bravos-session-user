#!/bin/bash
# BraveOS user-side session (runs as 'brave', started by bravos-session).
# openbox-session triggers /etc/xdg/openbox/autostart, which brings up
# picom, tint2, nm-applet, pcmanfm --desktop and the welcome/installer app.
set -u

export DISPLAY=:0
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=BRAVEOS
export DESKTOP_SESSION=bravos

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

LOG="$XDG_RUNTIME_DIR/bravos-session.log"
exec > "$LOG" 2>&1

if command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax --exit-with-session)" || true
  export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
fi

echo "bravos-session-user: launching openbox at $(date)"
touch "$XDG_RUNTIME_DIR/session-ready"

exec openbox-session
