#!/bin/bash
# BraveOS graphical session launcher (runs as ROOT via systemd).
# Root owns the console and DRM device on a bare live boot, so Xorg must be
# started here; the actual desktop session is dropped to 'brave' via runuser.
set -u

RD=/run/bravos-session
LOG="$RD/bravos-session.log"
mkdir -p "$RD"
chmod 755 "$RD"
exec > "$LOG" 2>&1

kmsg() { echo "bravos-session: $*" > /dev/kmsg 2>/dev/null || true; }

echo "bravos-session: starting at $(date)"
kmsg "starting"

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=BRAVEOS
export DESKTOP_SESSION=bravos

cleanup() { [ -n "${XORG_PID:-}" ] && kill "$XORG_PID" 2>/dev/null || true; }
trap cleanup EXIT

# X on vt1 as root
Xorg :0 vt1 -nolisten tcp -novtswitch -logfile "$RD/xorg.log" &
XORG_PID=$!

for i in $(seq 1 40); do
  [ -S /tmp/.X11-unix/X0 ] && break
  kill -0 "$XORG_PID" 2>/dev/null || break
  sleep 0.5
done

if [ ! -S /tmp/.X11-unix/X0 ]; then
  kmsg "X FAILED - dumping xorg log to console"
  echo "bravos-session: X failed; xorg log tail follows:"
  tail -n 30 "$RD/xorg.log" 2>/dev/null
  tail -n 20 "$RD/xorg.log" > /dev/kmsg 2>/dev/null || true
  touch "$RD/session-failed"
  exit 1
fi
echo "bravos-session: X socket ready"

touch "$RD/session-ready"
kmsg "session-ready (X up; launching user session)"

runuser -u brave -- /usr/local/bin/bravos-session-user
RC=$?
kmsg "user session exited rc=$RC"
exit $RC
