#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""BraveOS Welcome - first-run dialog in the live session.

Three clear actions: Try the live session, install to disk, launch Brave.
Closes automatically once the user picks one.
"""
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to BraveOS")
        self.set_default_size(560, 330)
        self.set_resizable(False)
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Welcome to BraveOS")
        self.set_titlebar(header)

        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        v.set_margin_left(26)
        v.set_margin_right(26)
        v.set_margin_top(16)
        v.set_margin_bottom(16)
        self.add(v)

        brand = Gtk.Label()
        brand.set_markup("<span size='xx-large' weight='bold' color='#ff7a45'>"
                         "BraveOS</span>\n<span color='#9a9aa0'>The Brave "
                         "Browser Distribution (unofficial)</span>")
        v.pack_start(brand, False, False, 8)

        info = Gtk.Label(xalign=0)
        info.set_wrap(True)
        info.set_markup("You are running the <b>live session</b>. Nothing "
                        "has been installed yet. Try everything — Brave, "
                        "Files, Settings — then install when you are ready. "
                        "Installing erases one disk of your choice.")
        v.pack_start(info, False, False, 4)

        grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        v.pack_start(grid, True, True, 10)

        def tile(row, icon_path, title, desc, cb, suggested=False):
            b = Gtk.Button()
            g = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            try:
                g.pack_start(Gtk.Image.new_from_file(icon_path), False, False, 4)
            except Exception:
                pass
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            lab = Gtk.Label(xalign=0)
            lab.set_markup("<b>%s</b>\n<span size='small' color='#9a9aa0'>%s"
                           "</span>" % (title, desc))
            t.pack_start(lab, True, True, 0)
            g.pack_start(t, True, True, 0)
            b.add(g)
            if suggested:
                b.get_style_context().add_class("suggested-action")
            b.set_hexpand(True)
            b.connect("clicked", cb)
            grid.attach(b, 0, row, 1, 1)
            return b

        tile(0, "/usr/share/bravos/icons/icon-brave.png",
             "Use Brave now", "the system's core app, preconfigured",
             lambda *_: self.go(["brave", "--maximized", "--no-first-run"]))
        tile(1, "/usr/share/bravos/icons/icon-folder.png",
             "Browse files", "PCManFM file manager",
             lambda *_: self.go(["pcmanfm"]))
        tile(2, "/usr/share/bravos/icons/icon-installer.png",
             "Install BraveOS to disk", "guided installer — erases one disk",
             self.install, suggested=True)

        note = Gtk.Label()
        note.set_markup("<span size='small' color='#7a7a80'>This window can "
                        "be reopened from the desktop icon or Settings → "
                        "Live Session.</span>")
        v.pack_start(note, False, False, 2)

    def go(self, cmd):
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.destroy()

    def install(self, *_):
        subprocess.Popen(["bravos-live-install"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.destroy()


def main():
    w = Welcome()
    w.show_all()
    # do not steal focus forever; quit when closed
    GLib.timeout_add(300, lambda: True)  # keep-alive for smooth events
    w.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
